---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Awal Amoo">
  <section class="home">
    <div class="home-hero">
      <div class="home-text">
        <h1 class="home-name">Hey, I'm Awal. <span class="wave" aria-label="waving hand">👋🏿</span></h1>
        <p class="home-tagline">
          Senior Product Manager. The kind of finance guy who builds
          the business case <em>and</em> ships the product.
        </p>
        <p class="home-welcome">Welcome to my corner of the internet.</p>
        <a href="/Awal_Amoo_Resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-hire">Hire Me</a>
        <div class="home-links">
          <div class="home-world">
            <span class="meta">Professional</span>
            <div class="home-world-links">
              <a href="/work/" class="btn">Case Studies</a>
              <a href="/media/" class="btn">Projects</a>
            </div>
          </div>
          <div class="home-world">
            <span class="meta">Personal</span>
            <div class="home-world-links">
              <a href="/writing/" class="btn">Writing</a>
              <a href="/about/" class="btn">About</a>
            </div>
          </div>
        </div>
      </div>
      <div class="home-headshot">
        <img src="/headshot-placeholder.svg" alt="Awal" width="180" height="180" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Container: fills viewport, centers content ---- */
  .home {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---- Hero: text left, headshot right ---- */
  .home-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    width: 100%;
  }

  .home-text {
    flex: 1;
    min-width: 0;
    max-width: 560px;
  }

  /* ---- Heading ---- */
  .home-name {
    font-size: clamp(2rem, 5vw, 3.4rem);
    margin-bottom: 0.6em;
    line-height: 1.1;
    white-space: nowrap;
  }

  /* ---- Waving hand ---- */
  .wave {
    display: inline-block;
    animation: wave 2.2s ease-in-out infinite;
    transform-origin: 70% 70%;
    font-size: 0.8em;
  }

  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    10%  { transform: rotate(16deg); }
    20%  { transform: rotate(-6deg); }
    30%  { transform: rotate(16deg); }
    40%  { transform: rotate(-4deg); }
    50%  { transform: rotate(12deg); }
    60%, 100% { transform: rotate(0deg); }
  }

  /* ---- Tagline ---- */
  .home-tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 0.6rem;
  }

  .home-tagline em {
    color: var(--accent);
    font-style: italic;
  }

  /* ---- Welcome ---- */
  .home-welcome {
    font-size: 0.9rem;
    color: var(--text-muted);
    opacity: 0.6;
    margin-bottom: 1.8rem;
    font-style: italic;
  }

  /* ---- Hire Me button ---- */
  .btn-hire {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    margin-bottom: 2rem;
    font-weight: 600;
  }

  .btn-hire:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--bg);
  }

  /* ---- Entry point buttons ---- */
  .home-links {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .home-world {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .home-world-links {
    display: flex;
    gap: 0.6rem;
  }

  /* ---- Headshot ---- */
  .home-headshot {
    flex-shrink: 0;
    width: 160px;
    height: 160px;
  }

  .home-headshot img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* ---- Tablet ---- */
  @media (max-width: 860px) {
    .home {
      padding: 0 1.5rem;
    }

    .home-hero {
      gap: 2rem;
    }

    .home-headshot {
      width: 140px;
      height: 140px;
    }

    .home-name {
      white-space: normal;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 600px) {
    .home {
      padding: 3rem 1.25rem;
      align-items: flex-start;
    }

    .home-hero {
      flex-direction: column-reverse;
      gap: 1.5rem;
      text-align: center;
      align-items: center;
    }

    .home-text {
      max-width: 100%;
    }

    .home-name {
      font-size: 2rem;
      white-space: normal;
    }

    .home-tagline {
      font-size: 1rem;
    }

    .home-headshot {
      width: 120px;
      height: 120px;
    }

    .home-links {
      justify-content: center;
      gap: 1.5rem;
    }

    .btn-hire {
      width: 100%;
      text-align: center;
    }
  }

  /* ---- Small phones ---- */
  @media (max-width: 380px) {
    .home {
      padding: 2rem 1rem;
    }

    .home-name {
      font-size: 1.7rem;
    }

    .home-tagline {
      font-size: 0.95rem;
    }

    .home-welcome {
      font-size: 0.85rem;
    }

    .home-headshot {
      width: 100px;
      height: 100px;
    }

    .home-links {
      gap: 1.25rem;
    }

    .home-world-links {
      gap: 0.5rem;
    }
  }
</style>
