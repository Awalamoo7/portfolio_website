---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="home">
    <h1 class="home-name">Your Name</h1>
    <p class="home-bio">
      Writer, builder, and thinker. I make things at the intersection of
      technology and culture, and write about what I learn along the way.
    </p>
    <div class="home-links">
      <div class="home-world">
        <span class="meta">Professional</span>
        <div class="home-world-links">
          <a href="/work/" class="btn">Work</a>
          <a href="/media/" class="btn">Media</a>
        </div>
      </div>
      <div class="home-world">
        <span class="meta">Personal</span>
        <div class="home-world-links">
          <a href="/writing/" class="btn">Writing</a>
          <a href="/about/" class="btn">About</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 8rem 2rem;
    min-height: calc(100vh - var(--nav-height) - 8rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .home-name {
    font-size: clamp(3rem, 8vw, 5rem);
    margin-bottom: 0.3em;
  }

  .home-bio {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 540px;
    margin-bottom: 3rem;
  }

  .home-links {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .home-world {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .home-world-links {
    display: flex;
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .home {
      padding: 4rem 1.5rem;
    }

    .home-links {
      gap: 2rem;
    }
  }
</style>
