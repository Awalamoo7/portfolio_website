---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const appearances = (await getCollection('media'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects">
  <section class="page">
    <header class="page-header">
      <p class="meta">Professional</p>
      <h1>Projects</h1>
    </header>

    {appearances.length === 0 ? (
      <p class="empty">Nothing here yet. Check back soon.</p>
    ) : (
      <ul class="content-list">
        {appearances.map((item) => (
          <li class="fade-in">
            <a href={item.data.url} target="_blank" rel="noopener noreferrer">
              <div class="title">{item.data.title}</div>
              {item.data.description && <div class="subtitle">{item.data.description}</div>}
              <div class="meta">
                <span>{item.data.type}</span>
                {' \u2014 '}
                <span>{item.data.venue}</span>
                {' \u2014 '}
                <span>
                  {item.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                  })}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-header .meta {
    margin-bottom: 1rem;
    display: block;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .empty {
    color: var(--text-muted);
    font-style: italic;
  }
</style>
