---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing">
  <section class="page">
    <header class="page-header">
      <p class="meta">Personal</p>
      <h1>Writing</h1>
    </header>

    {posts.length === 0 ? (
      <p class="empty">Nothing here yet. Check back soon.</p>
    ) : (
      <ul class="content-list">
        {posts.map((post) => {
          const href = post.data.url || `/writing/${post.id}/`;
          const isExternal = !!post.data.url;
          return (
            <li class="fade-in">
              <a href={href} {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                <div class="title">{post.data.title}{isExternal && <span class="external-icon" aria-label="external link"> ↗</span>}</div>
                {post.data.subtitle && <div class="subtitle">{post.data.subtitle}</div>}
                <div class="meta">
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-header .meta {
    margin-bottom: 1rem;
    display: block;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .empty {
    color: var(--text-muted);
    font-style: italic;
  }
</style>
