---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <p class="meta">&copy; {year}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
    margin-top: 6rem;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }
</style>
